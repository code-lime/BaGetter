{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build: BaGetter Web",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/BaGetter/BaGetter.csproj"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build: BaGetter WPF",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/BaGetter.WPF/BaGetter.WPF.csproj"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
