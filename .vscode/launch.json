{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "BaGetter Web (.NET 10)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: BaGetter Web",
            "program": "${workspaceFolder}/src/BaGetter/bin/Debug/net10.0/BaGetter.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/BaGetter",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:50561"
            }
        },
        {
            "name": "BaGetter WPF (.NET 10)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: BaGetter WPF",
            "program": "${workspaceFolder}/src/BaGetter.WPF/bin/Debug/net10.0-windows/BaGetter.WPF.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/BaGetter.WPF",
            "stopAtEntry": false,
            "internalConsoleOptions": "neverOpen",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:50561"
            }
        },
        {
            "name": ".NET Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
